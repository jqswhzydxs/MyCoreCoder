{
  "mcpServers": {
    "knowledge": {
      "client": "sdk",
      "command": "python",
      "args": ["-m", "corecoder", "mcp", "serve-knowledge", "--root", "/absolute/path/to/project", "--mode", "lexical"],
      "protocolMode": "auto",
